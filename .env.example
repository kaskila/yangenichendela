# Copy to .env and fill in. Never commit .env.
# Keep this file in sync with every variable the code actually reads.

# --- Database (Neon PostgreSQL) ---
# Pooled connection — used by the app at runtime (src/lib/db.ts).
DATABASE_URL=
# Direct (non-pooled) connection — used by prisma migrate (prisma.config.ts).
DIRECT_URL=

# --- Auth (Better Auth) ---
# Random 32+ char secret: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Canonical origin of the deployment, e.g. https://yangenichendela.com
BETTER_AUTH_URL=
# Public base URL used by the browser; usually the same origin.
NEXT_PUBLIC_APP_URL=

# --- Cloudinary (images + private receipt uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Mobile money merchant numbers (prisma/seed-store.ts only) ---
# Never hardcode these in a committed file. Client open-item; leave blank until
# confirmed. Manage the live set in the admin at /admin/settings.
MERCHANT_AIRTEL_NUMBER=
MERCHANT_MTN_NUMBER=

# --- Transactional email (Resend or Brevo — decision pending) ---
RESEND_API_KEY=
# BREVO_API_KEY=
# From address for transactional mail, e.g. "Yangeni Chendela <hello@example.com>"
EMAIL_FROM=
